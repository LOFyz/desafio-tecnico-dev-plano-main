dist
tmp
out-tsc

# scripts/serve-prod.sh background-process artifacts
.logs
.run

# SST (Ion) deploy artifacts and OpenNext build output
.sst
.open-next

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json


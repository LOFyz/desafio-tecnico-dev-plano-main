{
  "name": "@desafio/mcp-server",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "mcp-server",
    "targets": {
      "build": {
        "executor": "@nx/rspack:rspack",
        "outputs": [
          "{workspaceRoot}/apps/mcp-server/dist"
        ],
        "options": {
          "rspackConfig": "apps/mcp-server/rspack.config.js",
          "tsConfig": "apps/mcp-server/tsconfig.app.json",
          "main": "apps/mcp-server/src/main.ts",
          "outputPath": "apps/mcp-server/dist",
          "target": "node",
          "mode": "production",
          "optimization": false,
          "outputHashing": "none",
          "sourceMap": true,
          "generatePackageJson": false,
          "assets": ["apps/mcp-server/src/assets"],
          "skipTypeChecking": true
        },
        "configurations": {
          "development": {
            "mode": "development"
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": ["build"],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/mcp-server/dist/package.json",
          "{workspaceRoot}/apps/mcp-server/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": ["build"],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/mcp-server/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": ["build"],
        "options": {
          "buildTarget": "mcp-server:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "mcp-server:build:development"
          },
          "production": {
            "buildTarget": "mcp-server:build:production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "express": "^4.21.0",
    "graphql": "^16.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "zod": "^3.24.1"
  }
}

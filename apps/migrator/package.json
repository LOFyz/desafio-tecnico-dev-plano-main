{
  "name": "@desafio/migrator",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "migrator",
    "targets": {
      "build": {
        "executor": "@nx/rspack:rspack",
        "outputs": [
          "{workspaceRoot}/apps/migrator/dist"
        ],
        "options": {
          "rspackConfig": "apps/migrator/rspack.config.js",
          "tsConfig": "apps/migrator/tsconfig.app.json",
          "main": "apps/migrator/src/main.ts",
          "outputPath": "apps/migrator/dist",
          "target": "node",
          "mode": "production",
          "optimization": false,
          "outputHashing": "none",
          "sourceMap": true,
          "generatePackageJson": false,
          "assets": ["apps/migrator/src/assets"],
          "skipTypeChecking": true
        },
        "configurations": {
          "development": {
            "mode": "development"
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/migrator/dist/package.json",
          "{workspaceRoot}/apps/migrator/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/migrator/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "migrator:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "migrator:build:development"
          },
          "production": {
            "buildTarget": "migrator:build:production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@desafio/db": "workspace:*",
    "@desafio/users-infrastructure": "workspace:*",
    "@mikro-orm/core": "^7.0.14",
    "@mikro-orm/migrations": "^7.0.14",
    "@mikro-orm/nestjs": "^7.0.1",
    "@mikro-orm/postgresql": "^7.0.14",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}

# apps/web — local development env
# Copy to apps/web/.env.local. Next.js auto-loads .env.local for the web app.

# Dev server port (must NOT collide with the gateway on 3000 or users-subgraph on 3001)
WEB_PORT=4200

# Upstream URLs used by next.config.js to build /api/* rewrites and by lib/auth/session.ts
# for direct server-to-server calls. The browser only ever sees /api/graphql and /api/auth/*.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3001

# Schema source for `pnpm codegen` / `pnpm nx run @desafio/web:codegen`. Defaults to the gateway.
CODEGEN_SCHEMA_URL=http://localhost:3000/graphql

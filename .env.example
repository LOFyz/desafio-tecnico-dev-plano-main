# PostgreSQL connection (used by NestJS gateway and MikroORM CLI)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=desafio
DB_USER=desafio
DB_PASSWORD=desafio

# Better Auth (users-subgraph)
BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_BASE_PATH=/auth
# Origins allowed to call sign-out and other CSRF-sensitive endpoints.
# Comma-separated. Must include the web app origin (Next.js dev/prod URL).
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4200

# Google OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apollo Gateway (apps/gateway)
USERS_SUBGRAPH_URL=http://localhost:3001/graphql
# `posts` subgraph is WordPress (wp-graphql + wp-graphql-federations) served by the nginx container
POSTS_SUBGRAPH_URL=http://localhost:8080/graphql

# WordPress service-account JWT (used by users-subgraph to look up wp_user_id at signup,
# and by the wp-user-backfill app for one-shot backfills). Mint with:
#   curl -s http://localhost:8080/graphql -H 'Content-Type: application/json' \
#     -d '{"query":"mutation { login(input:{username:\"desafio-svc\",password:\"desafio-svc-password\"}){authToken}}"}'
# then paste the authToken below. WP_GRAPHQL_URL defaults to POSTS_SUBGRAPH_URL.
WP_GRAPHQL_URL=http://localhost:8080/graphql
WP_GRAPHQL_SERVICE_TOKEN=

# Web frontend (apps/web)
WEB_PORT=4200
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
# Codegen reads this when introspecting the schema. Defaults to NEXT_PUBLIC_GATEWAY_URL/graphql.
CODEGEN_SCHEMA_URL=http://localhost:3000/graphql

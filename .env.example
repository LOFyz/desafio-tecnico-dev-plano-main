# PostgreSQL connection (used by NestJS gateway and MikroORM CLI)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=desafio
DB_USER=desafio
DB_PASSWORD=desafio

# Better Auth (users-subgraph)
BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_BASE_PATH=/auth

# Google OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apollo Gateway (apps/gateway)
USERS_SUBGRAPH_URL=http://localhost:3001/graphql

# Per-app node_modules (the workspace one at /node_modules is INCLUDED so
# the Service Dockerfiles can COPY it instead of running `pnpm install`
# inside the BuildKit container — avoids the WSL2/Docker DNS flake hitting
# registry.npmjs.org during the build).
apps/*/node_modules
libs/**/node_modules
**/dist
**/.next
**/.sst
**/.open-next
**/.logs
**/.run
**/coverage
**/tmp
**/out-tsc
**/.nx
**/.turbo
**/.cache

# Local env files — never bake into images. Secrets come from sst secret set.
.env
.env.*
!.env.example
**/.env.local
**/.env.development
**/.env.production

# IDE / git noise
.git
.gitignore
.idea
.vscode
*.log

# Build outputs from the WP container we don't ship via app images
docker/wordpress/dist


# sst
.sst